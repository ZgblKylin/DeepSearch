{
  "name": "deepsearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSearch：纯前端 DeepSeek 搜索与 AI 摘要站点",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:deadcode": "knip",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "check": "npm run typecheck && npm run test:run && npm run build && npm run verify:artifacts"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
